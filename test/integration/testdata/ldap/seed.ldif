# postern LDAP entegrasyon testi verisi.
#
# İki grup şeması birden var, çünkü ikisini de desteklememiz gerekiyor:
#
#   1. groupOfNames — üyelik GRUBUN üstünde (member özniteliği). Grup
#      araması (group_base + group_filter) bu şemayı okur.
#
#   2. Kullanıcı girdisindeki çoklu-değerli öznitelik — üyelik
#      KULLANICININ üstünde. Gerçek dizinlerde bu "memberOf" olur (AD ve
#      memberOf overlay'li OpenLDAP). Testte "ou" kullanıyoruz çünkü
#      memberOf operasyonel bir özniteliktir ve bootstrap LDIF'iyle elle
#      yazılamaz; okuma mekanizması ise birebir aynı — kod öznitelik
#      adını yapılandırmadan alıyor, "memberOf" diye bir varsayımı yok.

dn: ou=people,dc=warewave,dc=io
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=warewave,dc=io
objectClass: organizationalUnit
ou: groups

