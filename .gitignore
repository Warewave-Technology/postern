# Derleme çıktıları
/bin/
# goreleaser çıktısı: `make release-snapshot` buraya yazıyor.
/dist/
# `go build` çıktıyı modül adıyla çalışma dizinine bırakır; Makefile
# bin/ altına yazıyor ama elle koşulan bir go build bunu üretir.
/postern

# Oturum kayıtları
/recordings/
*.cast

# Test/coverage artıkları
coverage.out

# Gerçek anahtarlar asla repoya girmez (testdata placeholder'ları hariç,
# onlar anahtar değil düz metin)
*.pem

# Elle çalıştırma için ssh-keygen ile üretilen GERÇEK anahtarlar (S1.2+).
# Taze clone'da yeniden üretilmeleri gerekir — bkz. README.
# (Birim test verisi ayrıdır: internal/config/testdata/keys/ altındaki
# placeholder'lar anahtar değil düz metindir ve repoda kalır.)
/testdata/keys/*

# macOS
.DS_Store

# CA özel anahtarı — asla repoya girmez
/testdata/ca_ed25519
/testdata/ca_ed25519.pub
/testdata/postern.db*

# ⚠️ KÖKTE node_modules. web/.gitignore yalnızca web/node_modules/'i
# kapsıyordu; kökte yanlışlıkla koşan bir `npm install`ın bıraktığı
# vitest önbelleği REPOYA GİRDİ ve içinde .claude worktree yolları ve
# 35 test paketinin 29'u "failed: true" olarak duruyordu — bir Go
# güvenlik ürününün kökünde, hiçbir açıklama olmadan.
node_modules/
